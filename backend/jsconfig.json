{
  "compilerOptions": {
    "forceConsistentCasingInFileNames": true,
    "strict": false,
    "target": "ES2020",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true
  },
  "include": ["**/*.js", "**/*.jsx", "routes/cartRouterjs"],
  "exclude": ["node_modules"]
}